      "html": "<nav class=\"ds-nav\" aria-label=\"Product\"><a href=\"#team\" aria-current=\"page\">Team</a><a href=\"#setup\">Setup</a><a href=\"#history\">History</a></nav>",
      "css": ".ds-nav{display:flex;background:var(--spike-frame);}.ds-nav a{position:relative;display:grid;min-height:44px;min-width:70px;place-items:center;padding:0 14px;font-family:var(--font-display);font-size:.88rem;font-weight:700;letter-spacing:.045em;text-transform:uppercase;color:var(--spike-ink-muted);text-decoration:none;}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--spike-ink);}.ds-nav a[aria-current]::after{content:\"\";position:absolute;inset:auto 12px 0;height:3px;background:var(--spike-stitch);}.ds-nav a:focus-visible{outline: 3px solid var(--spike-focus); outline-offset: 2px;}@media(prefers-reduced-motion:reduce){.ds-nav{transition-duration:.01ms;animation-duration:.01ms;}}"
