      "css": ".ds-receipt{display:flex;gap:12px;justify-content:space-between;align-items:center;min-height:50px;padding:8px 12px;border:1px solid var(--spike-line-strong);border-radius:var(--radius-sm);background:var(--spike-control);color:var(--spike-ink);box-shadow:inset 3px 0 0 var(--spike-success);font-family:var(--font-body);}.ds-receipt button{min-height:44px;border-radius:var(--radius-sm);font-family:var(--font-display);font-weight:700;letter-spacing:.035em;cursor:pointer;padding:0 12px;background:transparent;color:var(--spike-ink);border:1px solid var(--spike-line-strong);}.ds-receipt button:hover{background:var(--spike-control-strong);}.ds-receipt button:focus-visible{outline: 3px solid var(--spike-focus); outline-offset: 2px;}@media(prefers-reduced-motion:reduce){.ds-receipt{transition-duration:.01ms;animation-duration:.01ms;}}"
    }
  ],
  "narrative": {
    "northStar": "Competition Hardware",
    "overview": "Spike feels like the equipment and officiating system used at an elite volleyball tournament: durable, exact, fast to read, and purpose-built for the court. The court is the instrument. Scores, player tags, rails, and action keys behave like a coherent scorer's console rather than a collection of app cards.\n\nThe system is designed for coaches and stat keepers working under variable gym lighting. Dark and light modes are equally intentional. Expression comes from court geometry, equipment labeling, structural framing, and decisive scale\u2014not decoration, hype, or gamification.",
    "keyCharacteristics": [
      "Court geometry and structural equipment rails.",
      "Cobalt playing surfaces with graphite and enamel shells.",
      "Condensed display lettering with open, readable body text.",
      "Flat panels, tactile controls, and scarce selection markers."
    ],
    "rules": [],
    "dos": [
      "Do make the court and match state visible before controls.",
      "Do preserve 44px touch targets, keyboard focus, reduced motion, and full accessible names.",
      "Do use real volleyball geometry and the user's six-player rotation."
    ],
    "donts": [
      "Don't use photoreal court imagery, extra opponent players, invented match data, marketing slogans, decorative gradients, glass, neon glow, esports motifs, bubbly cards, or elastic motion. CSS gradients that draw court lines are structural geometry.",
      "Don't let Ionic defaults become the visual identity.",
      "Don't trade scoring speed for spectacle."
    ]
  }
}
