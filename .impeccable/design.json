      "html": "<section class=\"ds-panel\"><h2>Saved players</h2><p>Add players to the Team Roster.</p></section>",
      "css": ".ds-panel{padding:16px;border:1px solid var(--spike-line-strong);border-radius:var(--radius-md);background:var(--spike-frame);color:var(--spike-ink);}.ds-panel h2{margin:0 0 8px;font-family:var(--font-display);font-size:1.4rem;text-transform:uppercase;letter-spacing:.04em;}.ds-panel p{margin:0;color:var(--spike-ink-muted);font-family:var(--font-body);}@media(prefers-reduced-motion:reduce){.ds-panel{transition-duration:.01ms;animation-duration:.01ms;}}"
