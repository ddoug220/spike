      "css": ".ds-control{min-height:44px;border-radius:var(--radius-sm);font-family:var(--font-display);font-weight:700;letter-spacing:.035em;cursor:pointer;background:var(--spike-control);color:var(--spike-ink);border:1px solid var(--spike-line-strong);padding:10px 14px;}.ds-control:hover{background:var(--spike-control-strong);}.ds-control:focus-visible{outline: 3px solid var(--spike-focus); outline-offset: 2px;}.ds-control:disabled{opacity:.5;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-control{transition-duration:.01ms;animation-duration:.01ms;}}"
