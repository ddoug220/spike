      "css": ".ds-player{display:grid;align-content:center;gap:3px;width:108px;height:76px;border:1px solid rgba(255,255,255,.58);border-radius:var(--radius-sm);background:rgba(15,20,24,.94);color:#fff;cursor:pointer;transition:border-color var(--duration-fast) var(--ease-out);}.ds-player strong{font-family:var(--font-display);font-size:1.05rem;}.ds-player span{font-family:var(--font-body);font-size:.85rem;}.ds-player small{color:#d9e3eb;font-family:var(--font-display);font-size:.82rem;}.ds-player:hover{border-color:#fff;}.ds-player[aria-pressed=true]{background:var(--spike-canvas);border-color:var(--spike-stitch);box-shadow:inset 0 -4px 0 var(--spike-stitch);clip-path:polygon(0 0,calc(100% - 11px) 0,100% 11px,100% 100%,0 100%);background:#0f1418;}.ds-player:focus-visible{outline: 3px solid var(--spike-focus); outline-offset: 2px;}@media(prefers-reduced-motion:reduce){.ds-player{transition-duration:.01ms;animation-duration:.01ms;}}"
